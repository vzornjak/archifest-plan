<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Declared so DocumentGroup saves into the app's own iCloud Drive
	     folder, matching the Numbers-style "own file, own iCloud folder"
	     behaviour that was asked for. NOT ENOUGH BY ITSELF: Apple blocks the
	     iCloud capability entirely on a free "Personal Team" (confirmed —
	     see ios/README.md) — it needs a paid Apple Developer Program
	     membership before Xcode's Signing & Capabilities tab will actually
	     let this take effect. Until then the app still works correctly:
	     DocumentGroup just shows on-device storage only, no crash. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.hr.archifest.plan</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.hr.archifest.plan</string>
	</array>
</dict>
</plist>
